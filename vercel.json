{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "app": {
            "root": ".",
            "runtime": "python"
        },
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "server": {
            "root": "server",
            "framework": "flask"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ]
}